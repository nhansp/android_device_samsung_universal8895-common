# Graphics: as stock N950NKSU5DZE2 /system/build.prop
ro.zygote.disable_gl_preload=true

# RIL: single SIM, as stock default.prop (read by gpsd and libsemnativecarrierfeature)
ro.multisim.simslotcount=1

# SurfaceFlinger for the HWC1 composer, as codeberg universal8895 lineage-23.2 system.prop:43-48
# (the properties lineage-24.0 SurfaceFlinger.cpp:511,560,563 still reads; debug.hwc.winupdate is
# read by the HWC)
debug.hwc.winupdate=1
debug.sf.disable_client_composition_cache=1
debug.sf.predict_hwc_composition_strategy=0
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# SurfaceFlinger frame durations of the Pixel 6 (device/google/gs101/device.mk)
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=10500000
debug.sf.late.app.duration=16600000

# ADPF hint sessions for SurfaceFlinger and HWUI, as hardware/google/pixel/power-libperfmgr/aidl/device.mk
debug.sf.enable_adpf_cpu_hint=true
debug.hwui.use_hint_manager=true

# SoC name, as stock N950NKSU5DZE2 /system/build.prop and codeberg universal8895 lineage-23.2 system.prop:24
ro.arch=exynos8895
