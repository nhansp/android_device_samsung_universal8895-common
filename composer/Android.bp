// hardware/interfaces' composer 2.1 passthrough service, linked against the stock HWC1 adapter
// (libhwc2on1adapter from the vendor tree). The prebuilt replaces the AOSP library, so the
// adapter header that library would export is included from its source directory.
cc_binary {
    name: "android.hardware.graphics.composer@2.1-service.exynos8895",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    init_rc: ["android.hardware.graphics.composer@2.1-service.exynos8895.rc"],
    include_dirs: ["hardware/interfaces/graphics/composer/2.1/utils/hwc2on1adapter/include"],
    header_libs: [
        "android.hardware.graphics.composer@2.1-passthrough",
    ],
    shared_libs: [
        "android.hardware.graphics.composer@2.1",
        "android.hardware.graphics.composer@2.1-resources",
        "libbase",
        "libbinder",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "libhwc2on1adapter",
        "libhwc2onfbadapter",
        "liblog",
        "libsync",
        "libutils",
    ],
}
