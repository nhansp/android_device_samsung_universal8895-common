<resources>
    <!-- The display has the DOZE and DOZE_SUSPEND power modes: the stock HWC reports doze support
         (libexynosdisplay ExynosDisplay::getDozeSupport) and passes both modes to the DECON with
         S3CFB_POWER_MODE (ExynosPrimaryDisplay::setPowerMode), which puts the panel in ALPM
         (kernel decon_set_doze/decon_set_doze_suspend). Without them SystemUI keeps the display ON
         for the always-on display, which holds the display suspend blocker all night. -->
    <bool name="doze_display_state_supported">true</bool>
    <bool name="doze_suspend_display_state_supported">true</bool>
    <bool name="config_enableShellMainThread">true</bool>

    <!-- Iris, the face sensor here, is not started by waking the screen: it fires the IR LED, and
         the rear fingerprint sensor is the lockscreen's unlock. As in stock One UI, it starts when
         the user swipes up to the bouncer, or swipes up again on the bouncer to retry. -->
    <integer-array name="config_face_auth_wake_up_triggers" />
</resources>
