<resources>
    <!-- Hardware keys: home (1) and volume (64); the Bixby key has no Android keycode, so no assistant bit -->
    <integer name="config_deviceHardwareKeys">65</integer>
    <integer name="config_deviceHardwareWakeKeys">65</integer>

    <!-- RGB notification and battery LED with adjustable pulse: 1 + 2 + 8 + 64 -->
    <integer name="config_deviceLightCapabilities">75</integer>

    <bool name="config_deviceSupportsWirelessCharging">true</bool>
    <bool name="config_haveHigherAspectRatioScreen">true</bool>
</resources>
