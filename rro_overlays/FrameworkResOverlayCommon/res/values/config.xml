    <!-- Brightness on the 0..1 LightsService scale: each float is the HAL step whose luminance in
         display_port_0.xml is closest to the stock level. The AOSP defaults of
         the dim and doze floats (0.05, 0.0) would otherwise win over any integer -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">0.996063</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.334646</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.153543</item>

    <!-- Always-on display luminance: HAL step 0.259843 reproduces the stock lit level 97 (70.1 nits);
         the panel shows doze levels from 97 up at its 60-nit low-power level and lower ones at 2 nits -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.259843</item>
    <bool name="config_allowAutoBrightnessWhileDozing">true</bool>
    <!-- The panel's low-power mode has two luminances only: no brightness ramps in doze -->
    <bool name="config_displayBrightnessBucketsInDoze">true</bool>

