    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
    <!-- Brightness. The stock framework-res values (N950NKSU5DZE2) are levels of the panel's
         0..255 range; the framework here works on the 0..1 scale of the LightsService, which
         reaches the panel as level ceil(round(1 + 254 * value) * 366 / 255) (display_port_0.xml).
         Each float below is the HAL step whose luminance in the display_port_0.xml map (stock
         config_screenBrightnessNits up to level 255, the panel's candela table above) is the
         closest to the stock level's config_screenBrightnessNits:
         minimum = stock 0, maximum = stock config_screenBrightnessExtendedMaximum (365),
         default = stock 123 (157.4 nits; the HAL steps either side give 152.0 and 162.0),
         dim = stock 57 (20.0 nits; the steps either side give 19.0 and 20.8).
         The AOSP defaults of the dim and doze floats (0.05, 0.0) would otherwise win over any
         integer. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">0.996063</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.334646</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.153543</item>

    <!-- Always-on display luminance. Stock has config_screenBrightnessDoze = 1 (2.2 nits) and
         config_aodBrightnessValues = [1, 97] (dark, lit); level 97 is 70.1 nits, which the HAL
         step 0.259843 reproduces exactly. The panel shows a doze level from 97 up at its 60-nit
         low-power level and a lower one at 2 nits. The lit value is the default; SystemUI lowers
         it to the user's brightness when that is lower. With adaptive brightness the light
         sensor picks dark or lit as stock did (doze mapping in display_port_0.xml). -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.259843</item>
    <bool name="config_allowAutoBrightnessWhileDozing">true</bool>
    <!-- The panel's low-power mode has two luminances only: no brightness ramps in doze. -->
    <bool name="config_displayBrightnessBucketsInDoze">true</bool>

    <!-- The sensor hub's pick-up gesture (android.sensor.pick_up_gesture, one-shot, wake-up):
         "Lift to check phone" wakes the device. -->
    <bool name="config_dozePulsePickup">true</bool>

