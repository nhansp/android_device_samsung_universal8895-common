# Audio: hw_get_module_by_class() tries ro.hardware.<class> first
# (hardware/libhardware/hardware.c:245), so audio.primary.exynos8895 is found without
# codeberg lineage-23.2's ro.arch (system.prop:24), which vendor_init may not set.
ro.hardware.audio.primary=exynos8895

# Bluetooth
ro.bt.bdaddr_path=/efs/bluetooth/bt_addr
bluetooth.device.class_of_device=90,2,12
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true

# Camera: the provider loads the stock HAL through camera.universal8895_wrapper, which adds
# torch strength levels
ro.hardware.camera=universal8895_wrapper

# Gatekeeper (vendor/lib64/hw/gatekeeper.exynos8895.so)
ro.hardware.gatekeeper=exynos8895

# SoC
ro.soc.manufacturer=Samsung
ro.soc.model=Exynos 8895

# Graphics
ro.hardware.egl=mali
ro.opengles.version=196610

# Incremental file system (the kernel has CONFIG_INCREMENTAL_FS)
ro.incremental.enable=true

# Wi-Fi
wifi.interface=wlan0

# RIL
ro.radio.noril=no
ro.vendor.multisim.simslotcount=1
ro.vendor.radio.default_network=9
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so

# FRP
ro.frp.pst=/dev/block/persistent

# Read by libaudioroute-samsung and libsec-ril (stock ro.product_ship)
ro.vendor.product_ship=true

# SurfaceFlinger: background blur (tested on this Mali G71: renders correctly)
ro.surface_flinger.supports_background_blur=1

# Memory: mmd sets up zram at the size stock swaps on (sswap "-f 2048", MB), with recompression
mmd.zram.enabled=true
mmd.zram.size=2147483648
mmd.zram.comp_algorithm=lzo-rle
mmd.zram.recompression.enabled=true
mmd.zram.recompression.algorithm=zstd
mmd.zram.writeback.enabled=false

# NFC: the S3NRN82 halimpl reads the firmware version out of the CORE_INIT_RSP (NCI 1.0)
ro.vendor.nfc.legacy_core_init_rsp=true
