# The S Pen digitizer reports BTN_TOOL_PEN and BTN_STYLUS; without a configuration Android classes
# it as a keyboard and a mouse as well, which shows the quick settings pager arrows. As LineageOS
# exynos9820-common (lineage-23.2) and sm8550-common
# (lineage-24.0, Galaxy S23 Ultra) configs/sec_e-pen.idc.
touch.deviceType = touchScreen
touch.orientationAware = 1
