<!--
     The panel scaler offers 1440x2960 and 1080x2220. The display has no identification data, so
     DisplayDeviceConfig finds this file by its port (0).
-->
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2220</height>
            <width>1080</width>
            <density>420</density>
        </density>
        <density>
            <height>2960</height>
            <width>1440</width>
            <density>560</density>
        </density>
    </densityMapping>
    <!--
         Backlight -> luminance. Each point is a value the lights HAL can send (panel brightness =
         value * 36600 / 255, level = ceil(brightness / 100)); levels 0..255 use the framework nits,
         HBM levels 256..365 the panel's candela table, and HAL value 255 is never requested. Levels
         256..280 are interpolated towards 465 because a repeated 420-nit point breaks the strictly
         increasing nits the spline needs
    -->
