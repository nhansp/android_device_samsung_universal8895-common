    <!--
         HBM (levels above 255) only applies to auto-brightness in bright light; the transition point
         is the last HAL value at level <= 255. HighBrightnessModeController has no unlimited budget:
         timeMinSecs = 0 would spin a 1 ms recalculation loop once the budget is used up, and
         timeMaxSecs = timeWindowSecs keeps past sessions from ever using it up
    -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.692913</transitionPoint>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>86400</timeWindowSecs>
            <timeMaxSecs>86400</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
    </highBrightnessMode>
