    <!--
         Stock offered the HBM levels (above UI_MAX_BRIGHTNESS = level 255) only to auto-brightness
         in bright light: config_autoBrightnessHbmAmbientLux = 3000 (stock framework-res). The
         transition point is the last HAL value that stays at level <= 255.
         Stock had no HBM time budget (none in stock framework-res, no timer in the stock panel
         driver, panel_bl.c), but HighBrightnessModeController has no unlimited setting. With
         timeMinSecs = 0 (or no timing, all three default to 0) a used-up budget still passes
         remainingTime >= timeMinMillis, so HBM stays on and the controller re-arms its
         recalculation at now + 0 + 1 ms, a 1 ms loop. timeMaxSecs = timeWindowSecs keeps the
         past sessions in the window from ever using the budget up; only one uninterrupted session
         of timeMaxSecs can, as the running session is not clipped to the window. One day is longer
         than daylight above 3000 lux lasts outside the polar summer. timeMinSecs is the example
         of DisplayDeviceConfig.java: a session that does use the budget up ends, and HBM comes
         back once 60 s of it are free again.
    -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.692913</transitionPoint>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>86400</timeWindowSecs>
            <timeMaxSecs>86400</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
    </highBrightnessMode>
    <!--
         Always-on display brightness from the light sensor, used with adaptive brightness
         (config_allowAutoBrightnessWhileDozing). Stock's AOD service (AODService_v40
         AODUiController.onLightSensorChanged) switches the panel to its 60-nit low-power level
         above 2 lux and to its 2-nit level otherwise, with the platform levels of framework-res
         config_aodBrightnessValues = {1, 97}: up to 2 lux the lowest HAL step (stock level 1 is
         below it), from 3 lux the step of level 97 (0.259843). The panel driver takes a doze level
         from 97 up as its 60-nit level and any lower one as its 2-nit level. The light sensor
         reports whole lux. The other auto-brightness values stay those of config.xml.
    -->
    <autoBrightness>
        <luxToBrightnessMapping>
            <mode>doze</mode>
            <map>
                <point>
                    <first>0</first>
                    <second>0.0</second>
                </point>
                <point>
                    <first>2</first>
                    <second>0.0</second>
                </point>
                <point>
                    <first>3</first>
                    <second>0.259843</second>
                </point>
            </map>
        </luxToBrightnessMapping>
    </autoBrightness>
</displayConfiguration>
