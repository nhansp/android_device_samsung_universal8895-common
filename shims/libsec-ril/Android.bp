cc_library_shared {
    name: "libsec-ril",
    srcs: ["smsc.cpp"],
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-DRIL_SHLIB",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    header_libs: ["ril_headers"],
    shared_libs: ["liblog"],
}
