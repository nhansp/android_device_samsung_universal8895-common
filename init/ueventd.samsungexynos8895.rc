# Audio (ABOX)
/dev/seiren               0660   system     audio

# Input
/dev/input/event*         0660   system     input

# Sensorhub (CONFIG_SENSORS_SSP_BBD, Broadcom bridge)
/dev/ssp_sensorhub        0660   system     system
/dev/batch_io             0600   system     system
/dev/iio:device*          0660   system     system
/dev/bbd_control          0660   system     system
/dev/bbd_packet           0660   system     system
/dev/bbd_patch            0660   system     system
/dev/bbd_reliable         0660   system     system
/dev/bbd_sensor           0660   system     system
/dev/bbd_sio              0660   system     system
/dev/ttyBCM*              0660   system     system

# Heart rate sensor
/dev/max_hrm              0600   system     system

# Fingerprint (vfs8xxx)
/dev/vfsspi               0660   system     system

# Trustonic Kinibi (mcDriverDaemon); set here rather than with a chown in an init .rc to keep
# vendor_init away from tee_device
/dev/mobicore             0700   system     system
/dev/mobicore-user        0666   radio      system

# Iris: the physical address of each IR frame for the iris trustlet
/dev/s5p-smem             0660   system     system
/dev/t-base-tui           0660   system     system
/dev/tzic                 0660   system     net_bt_admin

# NFC (CONFIG_SEC_NFC)
/dev/sec-nfc              0660   nfc        nfc

# Google FRP
/dev/block/by-name/PERSISTENT    0660    system    system

# Reactivation lock
/dev/block/by-name/STEADY        0660    system    system

# Modem
/dev/block/by-name/RADIO         0660    system    radio
/dev/block/by-name/CP_DEBUG      0660    radio     system

# Bluetooth UART
/dev/ttySAC1                     0660    bluetooth bluetooth

# Sensors
/sys/devices/virtual/input/input*    poll_delay    0660    system    radio
/sys/devices/virtual/input/input*    enable        0660    system    radio
/sys/devices/platform/soc@0/soc@0:usi@108c0000/108c0000.spi/spi_master/spi10/spi10.0/iio:device*    buffer/enable    0660    system    system
/sys/devices/platform/soc@0/soc@0:usi@108c0000/108c0000.spi/spi_master/spi10/spi10.0/iio:device*    buffer/length    0660    system    system
/sys/devices/platform/soc@0/soc@0:usi@108c0000/108c0000.spi/spi_master/spi10/spi10.0/iio:device*    poll_delay       0660    system    system

# Modem interface: rild opens umts_ipc0 as radio
/dev/umts*                       0660    system    radio
/dev/umts_csd                    0660    system    loop_radio
/dev/smd4                        0660    system    radio
/dev/ramdump_memshare            0660    system    radio
/dev/drb                         0660    system    radio

# Panel backlight and mDNIe; the panel framework registers them at the first display enable, after
# "on boot"
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/backlight/panel    brightness       0664    system    system
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    bypass           0664    system    media_rw
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    mode             0664    system    media_rw
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    scenario         0664    system    media_rw
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    hdr              0664    system    media_rw
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    accessibility    0664    system    system
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    sensorRGB        0664    system    system
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    mdnie_ldu        0664    system    system
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    night_mode       0664    system    system
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    color_lens       0664    system    system
/sys/devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel/mdnie    whiteRGB         0664    system    system
