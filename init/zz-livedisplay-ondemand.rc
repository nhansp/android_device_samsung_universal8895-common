# Started on demand: the mDNIe nodes appear at the first display enable, and with class hal the
# HAL probed before that, registered nothing and system_server waited for it forever
# The name sorts after vendor.lineage.livedisplay-service.samsung-exynos.rc so "override" finds the
# service already defined
service vendor.livedisplay-hal-samsung-exynos /vendor/bin/hw/vendor.lineage.livedisplay-service.samsung-exynos
    override
    class hal
    user system
    group system
    disabled
    interface aidl vendor.lineage.livedisplay.IDisplayColorCalibration/default
    interface aidl vendor.lineage.livedisplay.IDisplayModes/default
    interface aidl vendor.lineage.livedisplay.IReadingEnhancement/default
