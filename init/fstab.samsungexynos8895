# Android fstab file
#
# Mount options and flags follow the stock /fstab.samsungexynos8895 of N950NKSU5DZE2, with
# first-stage mount of /system (system-as-root). /data is not encrypted for now: file-based
# encryption needs the keymaster before vold can mount it. /metadata lives on the OMR
# partition (stock: empty) with the ext4 options of the Pixel 8 Pro /metadata entry; it is not
# first-stage mounted, aconfigd falls back to its post-fs init.
#
#<src>                                   <mnt_point>  <type>  <mnt_flags and options>                                                                  <fs_mgr_flags>
/dev/block/by-name/SYSTEM                /system      ext4    ro,errors=panic,noload                                                                   wait,first_stage_mount
/dev/block/by-name/CACHE                 /cache       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check
/dev/block/by-name/USERDATA              /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  latemount,wait,check,quota,reservedsize=128M
/dev/block/by-name/EFS                   /efs         ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check
/dev/block/by-name/CPEFS                 /cpefs       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check,nofail
/dev/block/by-name/OMR                   /metadata    ext4    noatime,nosuid,nodev,data=journal,commit=1                                               wait,check,formattable
/dev/block/by-name/MISC                  /misc        emmc    defaults                                                                                 defaults
/dev/block/by-name/BOOT                  /boot        emmc    defaults                                                                                 defaults
/dev/block/by-name/RECOVERY              /recovery    emmc    defaults                                                                                 defaults

# VOLD
/dev/block/by-name/HIDDEN                /preload     ext4    defaults                                                                                 voldmanaged=preload:auto
/devices/platform/soc@0/11500000.mmc/mmc_host*      auto  auto  defaults                                                                           voldmanaged=sdcard:auto,encryptable=userdata
/devices/platform/soc@0/10c00000.usb/10c00000.usb*  auto  auto  defaults                                                                           voldmanaged=usb:auto
