# Android fstab file
#
# The read-only partitions are logical partitions of the super partition on SYSTEM and HIDDEN
# /metadata lives on OMR (empty on stock), mounted in first stage so adb remount finds its scratch
# image on /data; a blank OMR is skipped there and formatted in second stage
# vendor and odm are EROFS with ext4 as fallback; /data is f2fs, with AID_RESERVED_DISK (1065)
# for its reserved blocks, or ext4
#
#<src>                                   <mnt_point>  <type>  <mnt_flags and options>                                                                  <fs_mgr_flags>
system                                   /system      ext4    ro,errors=panic,noload                                                                   wait,logical,first_stage_mount
system_ext                               /system_ext  ext4    ro,errors=panic,noload                                                                   wait,logical,first_stage_mount
product                                  /product     ext4    ro,errors=panic,noload                                                                   wait,logical,first_stage_mount
vendor                                   /vendor      erofs   ro                                                                                       wait,logical,first_stage_mount
vendor                                   /vendor      ext4    ro,errors=panic,noload                                                                   wait,logical,first_stage_mount
odm                                      /odm         erofs   ro                                                                                       wait,logical,first_stage_mount
odm                                      /odm         ext4    ro,errors=panic,noload                                                                   wait,logical,first_stage_mount
/dev/block/by-name/CACHE                 /cache       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check
/dev/block/by-name/USERDATA              /data        f2fs    noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=1065,inlinecrypt,compress_extension=apk,compress_extension=so,compress_extension=vdex,compress_extension=odex,compress_cache  latemount,wait,check,formattable,quota,fsverity,fscompress,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts:v2
/dev/block/by-name/USERDATA              /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic,inlinecrypt  latemount,wait,check,quota,fsverity,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts:v2
/dev/block/by-name/EFS                   /efs         ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check
/dev/block/by-name/CPEFS                 /cpefs       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check,nofail
/dev/block/by-name/OMR                   /metadata    ext4    noatime,nosuid,nodev,data=journal,commit=1                                               wait,check,formattable,first_stage_mount
/dev/block/by-name/MISC                  /misc        emmc    defaults                                                                                 defaults
/dev/block/by-name/BOOT                  /boot        emmc    defaults                                                                                 defaults
/dev/block/by-name/RECOVERY              /recovery    emmc    defaults                                                                                 defaults

# VOLD
/devices/platform/soc@0/11500000.mmc/mmc_host*            auto  auto  defaults                                                                         voldmanaged=sdcard:auto,encryptable=userdata
/devices/platform/soc@0/soc@0:usb@10c00000/10c00000.usb*  auto  auto  defaults                                                                         voldmanaged=usb:auto
