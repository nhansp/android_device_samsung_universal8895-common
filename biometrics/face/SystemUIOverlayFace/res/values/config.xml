<resources>
    <!-- SystemUI places the face sensor (config_face_auth_props) only for this camera -->
    <string name="config_protectedCameraId" translatable="false">1</string>

    <!-- Unlock ripple origin: the front camera, in the top bezel above the display -->
    <integer-array name="config_face_auth_props">
        <item>1007</item> <!-- sensorLocationX -->
        <item>0</item> <!-- sensorLocationY -->
        <item>33</item> <!-- sensorRadius -->
    </integer-array>
</resources>
