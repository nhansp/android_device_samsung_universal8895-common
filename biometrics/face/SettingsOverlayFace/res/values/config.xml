<resources>
    <!-- The face HAL opens the front camera and draws the enrollment preview -->
    <bool name="config_face_enroll_hal_owns_camera">true</bool>
    <!-- Preview::kSize: the 640x480 frame upright, middle square -->
    <integer name="face_preview_width">480</integer>
    <integer name="face_preview_height">480</integer>

    <!-- No attention (gaze) detection: the face library has no such option -->
    <bool name="config_face_attention_supported">false</bool>
</resources>
