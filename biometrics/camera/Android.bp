// The socket protocol between this daemon and the iris and face HALs
cc_library_headers {
    name: "vendor.lineage.biometrics.camera.samsung-headers",
    export_include_dirs: ["include"],
    vendor: true,
}

// Not in the iris or face APEX: it hosts the stock camera HAL, which stays in /vendor.
cc_binary {
    name: "vendor.lineage.biometrics.camera.samsung",
    srcs: [
        "Face.cpp",
        "Hal1Camera.cpp",
        "Iris.cpp",
        "main.cpp",
    ],
    init_rc: ["vendor.lineage.biometrics.camera.samsung.rc"],
    header_libs: [
        "libhardware_headers",
        "vendor.lineage.biometrics.camera.samsung-headers",
    ],
    shared_libs: [
        "libbase",
        "libcamera_metadata",
        "libcutils",
        "liblog",
    ],
    // It hosts the camera HAL, which is 32-bit only.
    compile_multilib: "32",
    vendor: true,
}
