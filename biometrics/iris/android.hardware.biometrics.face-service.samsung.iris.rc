on post-fs-data
    mkdir /data/vendor/biometrics/iris 0770 system system

service vendor.face-iris /vendor/bin/hw/android.hardware.biometrics.face-service.samsung.iris
    class late_start
    user system
    group system
    shutdown critical

# Hosts the iris camera like vendor.camera.provider hosts the others
service vendor.iris-camera /vendor/bin/iris_camera.samsung
    class late_start
    user cameraserver
    group audio camera input drmrpc usb
    socket iris_camera seqpacket 0660 system system
