<resources>
    <!-- SystemUI places the face sensor only for the front camera -->
    <string name="config_protectedCameraId" translatable="false">1</string>

    <!-- No wake-up trigger: iris fires the IR LED, so it starts on the swipe up to the bouncer -->
    <integer-array name="config_face_auth_wake_up_triggers" />

    <!-- The iris camera lens sits in the top bezel, above the display's top edge -->
    <integer-array name="config_face_auth_props">
        <item>308</item> <!-- sensorLocationX -->
        <item>0</item> <!-- sensorLocationY -->
        <item>31</item> <!-- sensorRadius -->
    </integer-array>
</resources>
