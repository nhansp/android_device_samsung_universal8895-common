android_app {
    name: "IrisOverlay",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.savedstate_savedstate",
        "kotlinx_coroutines_android",
        "vendor.lineage.biometrics.iris-V2-java",
    ],
    required: ["privapp-permissions_org.lineageos.iris"],
}

prebuilt_etc {
    name: "privapp-permissions_org.lineageos.iris",
    src: "privapp-permissions_org.lineageos.iris.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}
