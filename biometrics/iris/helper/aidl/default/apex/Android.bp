prebuilt_etc {
    name: "com.android.hardware.biometrics.iris.samsung.rc",
    src: "com.android.hardware.biometrics.iris.samsung.rc",
    installable: false,
}

// libIrisService.so is the one library taken from /vendor, exported by ../../../linker.config.json
apex {
    name: "com.android.hardware.biometrics.iris.samsung",
    manifest: "apex_manifest.json",
    file_contexts: "file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,

    binaries: [
        "vendor.lineage.biometrics.iris-service.samsung",
    ],
    prebuilts: [
        "vendor.lineage.biometrics.iris-service.samsung.xml",
        "com.android.hardware.biometrics.iris.samsung.rc",
    ],
}
