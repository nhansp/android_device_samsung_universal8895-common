# APEX rc files are read once the APEX is mounted, after post-fs-data has run
on property:apex.all.ready=true
    mkdir /data/vendor/biometrics/iris 0770 system system

service vendor.iris-default /apex/com.android.hardware.biometrics.iris.samsung/bin/hw/vendor.lineage.biometrics.iris-service.samsung
    class late_start
    user system
    group system
    shutdown critical
