// Installed only through com.android.hardware.biometrics.iris.samsung (apex/).
cc_binary {
    name: "vendor.lineage.biometrics.iris-service.samsung",
    relative_install_path: "hw",
    srcs: [
        "Face.cpp",
        "IrisCapture.cpp",
        "IrisLib.cpp",
        "PowerBoost.cpp",
        "Preview.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    header_libs: [
        "vendor.lineage.biometrics.camera.samsung-headers",
        "libhardware_headers",
        "libnativebase_headers",
    ],
    shared_libs: [
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.face-V4-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libnativewindow",
        "pixel-power-ext-V1-ndk",
        "vendor.lineage.biometrics.iris-V3-ndk",
    ],
    // The stock iris libraries are 64-bit only.
    compile_multilib: "64",
    vendor: true,
}

prebuilt_etc {
    name: "vendor.lineage.biometrics.iris-service.samsung.xml",
    src: "vendor.lineage.biometrics.iris-service.samsung.xml",
    sub_dir: "vintf",
    installable: false,
}
