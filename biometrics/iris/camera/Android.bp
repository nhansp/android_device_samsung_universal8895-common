// The socket protocol between this binary and the iris HAL
cc_library_headers {
    name: "vendor.lineage.biometrics.iris-camera.samsung-headers",
    export_include_dirs: ["include"],
    vendor: true,
}

// Not in the iris APEX: it hosts the stock camera HAL, which stays in /vendor.
cc_binary {
    name: "vendor.lineage.biometrics.iris-camera.samsung",
    srcs: ["IrisCamera.cpp"],
    init_rc: ["vendor.lineage.biometrics.iris-camera.samsung.rc"],
    header_libs: [
        "vendor.lineage.biometrics.iris-camera.samsung-headers",
        "libhardware_headers",
    ],
    shared_libs: [
        "libbase",
        "libcamera_metadata",
        "libcutils",
        "liblog",
    ],
    // It hosts the camera HAL, which is 32-bit only.
    compile_multilib: "32",
    vendor: true,
}
