cc_binary {
    name: "android.hardware.biometrics.face-service.samsung.iris",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.face-service.samsung.iris.rc"],
    vintf_fragments: ["android.hardware.biometrics.face-service.samsung.iris.xml"],
    srcs: [
        "Face.cpp",
        "IrisCapture.cpp",
        "IrisLib.cpp",
        "PowerBoost.cpp",
        "Preview.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    header_libs: [
        "libhardware_headers",
        "libnativebase_headers",
    ],
    shared_libs: [
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.face-V4-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libnativewindow",
        "pixel-power-ext-V1-ndk",
        "vendor.lineage.biometrics.iris-V2-ndk",
    ],
    required: ["iris_camera.samsung"],
    // The stock iris libraries are 64-bit only.
    compile_multilib: "64",
    vendor: true,
}

cc_binary {
    name: "iris_camera.samsung",
    srcs: ["camera/IrisCamera.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libbase",
        "libcamera_metadata",
        "libcutils",
        "liblog",
    ],
    // It hosts the camera HAL, which is 32-bit only.
    compile_multilib: "32",
    vendor: true,
}
