# vendor.samsung_slsi.hardware.ExynosHWCServiceTW is registered on vndbinder
vndbinder_use(hal_graphics_composer_default)

# libGrallocWrapper allocates through IAllocator
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)

# Exynos.HWCService is registered in-process; a plain allow, as add_service() would neverallow the
# same add by the samsung_slsi hal_vendor_hwcservice_default domain
allow hal_graphics_composer_default vendor_surfaceflinger_vndservice:service_manager { add find };

r_dir_file(hal_graphics_composer_default, sysfs_display)
r_dir_file(hal_graphics_composer_default, sysfs_chipid)

# Hotplug and DECON uevents
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# The HWC probes /data/vendor/log for its debug dumps
dontaudit hal_graphics_composer_default log_vendor_data_file:dir search;
