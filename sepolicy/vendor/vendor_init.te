# secril_config_svc.rc copies the vendor radio properties into ro.telephony.*
get_prop(vendor_init, vendor_radio_prop)
set_prop(vendor_init, vendor_radio_prop)

# /sys/class/sec/tsp/cmd: the double-tap-to-wake area at boot
allow vendor_init sysfs_touchscreen_writable:file w_file_perms;

allow vendor_init vendor_proc_swappiness:file w_file_perms;

# sys.mobicoredaemon.enable, seeded before mcDriverDaemon starts
set_prop(vendor_init, tee_prop)

# /dev/cpuctl/top-app/cpu.uclamp.min: handed to the power HAL at boot
allow vendor_init cgroup:file setattr;
