type nfc_vendor_data_file, file_type, data_file_type;
type cpefs_file, file_type;

# DECON (12860000.decon_f) sysfs: vsync and psr_info, read by the stock composer
type sysfs_display, sysfs_type, fs_type;

# SoC revision (/sys/devices/system/chip-id), read by the stock composer
type sysfs_chipid, sysfs_type, fs_type;

# Camera class (/sys/class/camera/{rear,front,ois,flash}) read by the camera HAL
type sysfs_camera, sysfs_type, fs_type;

# model_info-system_rev in the device tree, read by cbd
type sysfs_dt_model_info, sysfs_type, fs_type;

# /sys/class/video4linux and the MFC video4linux nodes (s5p-mfc-dec0, s5p-mfc-enc0 and the secure pair)
type sysfs_v4l, sysfs_type, fs_type;
type sysfs_v4l_mfc, sysfs_type, fs_type;

# /proc/sys/vm/swappiness, set at boot by the vendor init
type vendor_proc_swappiness, fs_type, proc_type;
