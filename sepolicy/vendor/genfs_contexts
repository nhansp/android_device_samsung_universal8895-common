# Display: DECON-F and the SoC revision the stock composer reads (6.18 sysfs paths)
genfscon sysfs /devices/platform/12860000.decon_f                                       u:object_r:sysfs_display:s0
genfscon sysfs /devices/system/chip-id                                                  u:object_r:sysfs_chipid:s0

# Battery: MAX77865 charger (32-0069) and fuel gauge (32-0036) on USI 10960000 (6.18 sysfs paths)
genfscon sysfs /devices/platform/soc@0/soc@0:usi@10960000/10970000.i2c/i2c-32/32-0069/power_supply u:object_r:sysfs_battery:s0
genfscon sysfs /devices/platform/soc@0/soc@0:usi@10960000/10970000.i2c/i2c-32/32-0036/power_supply u:object_r:sysfs_battery:s0

# IIO: the SSP sensor hub on spi10.0 and the other IIO devices the sensors HAL scans by name
genfscon sysfs /devices/platform/soc@0/soc@0:usi@108c0000/108c0000.spi/spi_master/spi10/spi10.0/iio:device u:object_r:sysfs_sensors_writable:s0
genfscon sysfs /devices/platform/soc@0/15b70000.adc/iio:device                          u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor-ap/iio:device                           u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor-battery/iio:device                      u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor-charger/iio:device                      u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor-pa/iio:device                           u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor-usb/iio:device                          u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor-wf/iio:device                           u:object_r:sysfs_iio:s0

# Camera class
genfscon sysfs /devices/virtual/camera                                                  u:object_r:sysfs_camera:s0

# Device tree model info
genfscon sysfs /firmware/devicetree/base/model_info-system_rev                          u:object_r:sysfs_dt_model_info:s0

# Panel and mDNIe (/sys/class/lcd/panel, /sys/class/mdnie/mdnie is panel/mdnie) at their 6.18 path
genfscon sysfs /devices/platform/soc@0/12870000.dsi/12870000.dsi.0/lcd/panel           u:object_r:sysfs_lcd_writable:s0

genfscon sysfs /devices/platform/bluetooth/rfkill/rfkill0/state                     u:object_r:sysfs_bt_writable:s0
genfscon sysfs /devices/platform/soc@0/12870000.dsi/12870000.dsi.0/backlight/panel  u:object_r:sysfs_backlight_writable:s0
genfscon sysfs /devices/platform/soc@0/soc@0:usi@10460000/10460000.spi/spi_master/spi3/spi3.0/madera-extcon/extcon u:object_r:sysfs_extcon:s0
genfscon sysfs /devices/platform/soc@0/11120000.ufs/host0                          u:object_r:sysfs_scsi_host_writable:s0
