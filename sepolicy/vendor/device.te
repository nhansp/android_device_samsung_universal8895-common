# /dev/m2m1shot_scaler0: the MScaler, used by the OMX components and the camera for conversions
type m2m1shot_device, dev_type;

# /dev/max_hrm: the heart rate sensor, opened by sensors.bio.so
type hrm_device, dev_type;

# /dev/s5p-smem: the physical address of an ION buffer, for the iris trustlet
type secmem_device, dev_type;

# SYSTEM and HIDDEN hold the super partition
typeattribute system_block_device super_block_device_type;
