# Fingerprint (vfs8xxx)
/dev/vfsspi                                             u:object_r:fp_sensor_device:s0

# GNSS
/(vendor|system/vendor)/bin/hw/android\.hardware\.gnss@1\.1-service\.samsung    u:object_r:hal_gnss_default_exec:s0

# NFC
/data/vendor/nfc(/.*)?                                  u:object_r:nfc_vendor_data_file:s0

# Modem partition mounted at the root (BOARD_ROOT_EXTRA_FOLDERS)
/cpefs(/.*)?    u:object_r:cpefs_file:s0

# HIDDEN is part of the super partition (BoardConfigCommon.mk)
/dev/block/platform/soc@0/11120000\.ufs/by-name/HIDDEN    u:object_r:system_block_device:s0

# /metadata lives on OMR; more specific than the samsung_slsi (omr|OMR) entry, so it wins
/dev/block/platform/soc@0/11120000\.ufs/by-name/OMR    u:object_r:metadata_block_device:s0

# Camera
/(vendor|system/vendor)/bin/hw/android\.hardware\.camera\.provider-service_32\.samsung    u:object_r:hal_camera_default_exec:s0
/data/vendor/camera(/.*)?                               u:object_r:vendor_camera_data_file:s0

# Iris
/(vendor|system/vendor)/bin/vendor\.lineage\.biometrics\.iris-camera\.samsung    u:object_r:hal_camera_default_exec:s0
/dev/s5p-smem                                           u:object_r:secmem_device:s0
/dev/socket/iris_camera                                 u:object_r:iris_camera_socket:s0

# Composer (stock HWC1 through the stock adapter)
/(vendor|system/vendor)/bin/hw/android\.hardware\.graphics\.composer@2\.1-service\.exynos8895    u:object_r:hal_graphics_composer_default_exec:s0

# GPU (Mali)
/dev/mali0                                              u:object_r:gpu_device:s0

# SELinux contexts of odm, which lives inside the vendor directory of the system partition
/(vendor|system/vendor)/odm/etc/selinux(/.*)?           u:object_r:vendor_configs_file:s0

/dev/fimg2d                                             u:object_r:graphics_device:s0
/dev/max_hrm                                            u:object_r:hrm_device:s0
/dev/m2m1shot_scaler0                                   u:object_r:m2m1shot_device:s0
/dev/socket/sap_uim_socket[0-9]*                        u:object_r:rild_socket:s0
/dev/umts_ramdump0                                       u:object_r:vendor_radio_device:s0
/efs/FactoryApp(/.*)?                                   u:object_r:app_efs_file:s0
/efs/TEE(/.*)?                                          u:object_r:prov_efs_file:s0
